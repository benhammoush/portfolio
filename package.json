{
  "name": "portfolio",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "scripts": {
    "ci:quality": "npm run format:check && npm run lint && npm run audit:dependencies && npm test && npm run build",
    "ci:browser": "npm run test:e2e",
    "generate:desktop-poster": "node scripts/capture-desktop-poster.mjs",
    "generate:workflow-art": "node scripts/export-workflow-art.mjs",
    "generate:apollo-art": "node scripts/export-workflow-art.mjs --apollo",
    "check:apollo-art": "node scripts/export-workflow-art.mjs --apollo --check",
    "check:workflow-art": "node scripts/export-workflow-art.mjs --check",
    "generate:iris-art": "node scripts/export-workflow-art.mjs --iris",
    "generate:gateway-art": "node scripts/export-workflow-art.mjs --gateway",
    "generate:dripperz-art": "node scripts/export-workflow-art.mjs --dripperz",
    "check:iris-art": "node scripts/export-workflow-art.mjs --iris --check",
    "check:gateway-art": "node scripts/export-workflow-art.mjs --gateway --check",
    "check:dripperz-art": "node scripts/export-workflow-art.mjs --dripperz --check",
    "dev": "vite",
    "build": "npm run check:version && npm run typecheck && vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "check:version": "node scripts/check-version.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:gpu": "playwright test --config playwright.gpu.config.ts",
    "audit:dependencies": "npm audit && npm audit --omit=dev",
    "check": "npm run format:check && npm run lint && npm run audit:dependencies && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-jsdoc": "65.3.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-tsdoc": "0.5.4",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
